FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3.05;

deltaT          0.001;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   12;

runTimeModifiable false;

adjustTimeStep  no;

libs            ( "libPhaseAveraging.so" );

functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            ( "libfieldFunctionObjects.so" );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
    bbpaV
    {
        type            BBPA;
        libs            ( "libPhaseAveraging.so" );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        writeMode       bin;
        PAwriteInterval 1;
        fields          ( U wallShearStress );

        // The physical inlet period is exactly 1.0 (verified: rms mismatch of
        // the mean waveform is 0.0034 at lag 1.0 vs 0.565 at lag 0.5).
        //
        // ON-GRID configuration, deliberately. period 1.0 with I=20 gives a bin
        // width of 0.05 = exactly 50 timesteps, so every bin edge and cycle
        // boundary lands ON a timestep and the bin times are round numbers:
        // 2.0, 2.05 ... 2.90, 2.95.
        //
        // This is the situation the production runs are actually in -- the
        // aorta uses period 0.5 with I=50, i.e. bin width 0.01 = its
        // writeInterval -- and it is what makes the bin directories coincide
        // with the solver's own write folders rather than landing on values
        // like 2.89913.
        //
        // It is also the harder case to verify: the FO bins on its internal
        // double for t while the checker reads t from the directory name, and
        // at a boundary those can differ by 1 ulp and put a step in a different
        // bin. That is a checker artifact rather than an FO defect, but it has
        // to be confronted rather than dodged.
        period          1.0;
        nBins           20;
        startCycle      0;
    }
}


