FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2.56;   // 128 x writeInterval -> the final write lands on endTime

deltaT          2.5e-4;

writeControl    adjustableRunTime;

writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   12;

runTimeModifiable false;

// The one job of this case (see README.md): ADAPTIVE time stepping.
// Steps vary with the pulsatile Courant number and straddle bin edges;
// adjustableRunTime nudges dt so writes still land exactly on the 0.02
// grid the phase selection derives its bins from.
adjustTimeStep  yes;
maxCo           0.6;
maxDeltaT       5e-4;

libs            ( "libPhaseAveraging.so" );

functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            ( "libfieldFunctionObjects.so" );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    runTime;
        writeInterval   0.02;
    }
    // One job (see README.md): ADAPTIVE dt and second-order statistics.
    // Steps vary and straddle bin edges; the forcing period is 0.5 (the
    // inlet boundaryData record replayed at t -> t/2, Womersley up by
    // sqrt(2)); the record carries a ~0.07 rms perturbation differing
    // every cycle, so the mean, <U U> and the variance are all
    // non-trivial. Cycle 0 is startup AND, with centred bins, its bin 0
    // is only half covered -- discard it.
    bbpaV
    {
        type            BBPA;
        libs            ( "libPhaseAveraging.so" );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;

        fields
        (
            U               { writePerCycle on; }
            wallShearStress { writePerCycle on; }
        );

        period          0.5;
        nBins           100;
        discardCycles   1;

        // Derive the tracked bins from the solver's write times: stride =
        // writeInterval/binWidth = 0.02/0.005 = 4, so bins 0,4,...,96 --
        // 25 of 100, each landing in a write folder. A hand list silently
        // rots the moment nBins or writeInterval changes. Centred bins
        // remove the half-bin phase lag at source.
        phaseSelection  { mode solverWriteTimes; }
        binAlignment    centred;

        output
        {
            layout                  both;
            cycleWriteInterval      1;
            meanWriteIntervalCycles 1;
        }
    }
}


