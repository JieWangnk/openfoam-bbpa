FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3;

deltaT          0.005;

writeControl    runTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs ("libPhaseAveraging.so");

functions
{
    #includeFunc wallShearStress

    // One job (see README.md): field TYPES and a DERIVED field --
    // U (vector), p (scalar), wallShearStress (produced by its own
    // function object above, data entirely on the wall patch) -- with
    // per-field products: p keeps only its mean; wallShearStress keeps
    // mean + <tau tau> (no variance); U keeps everything.
    bbpa
    {
        type            BBPA;
        libs            ("libPhaseAveraging.so");
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;

        fields
        (
            U
            p               { secondMoment off; crossCycleVariance off; }
            wallShearStress { crossCycleVariance off; }
        );

        period          1.0;
        nBins           10;
        discardCycles   0;

        output
        {
            layout              both;   // phase-aligned dirs + companion
            cycleWriteInterval  1;
        }
    }
}

