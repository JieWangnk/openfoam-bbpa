// BBPA (Bin-Based Phase Averaging) -- the v2 dictionary, annotated.
// Add one of these blocks to the functions{} section of system/controlDict.
//
// The model:
//   fields ( ... )   decides WHAT exists (per-field products);
//   the phase grid   decides WHERE in phase each sample lands;
//   *Selection { }   decide WHICH bins are held and which reach disk;
//   output { }       decides WHERE and WHEN files are written -- nothing
//                    in output{} can change a number.
//
// A guided tour of every entry, with runnable demos, is in docs/study/
// (start at docs/study/README.md). The worked reference case is
// tutorials/bbpaVerify.

functions
{
    // Minimal: every product for U, defaults everywhere else.
    bbpaMinimal
    {
        type            BBPA;
        libs            ("libPhaseAveraging.so");
        executeControl  timeStep;    // accumulate EVERY step: BBPA is a
        executeInterval 1;           // time integrator, not a sampler
        writeControl    writeTime;   // write whenever the solver writes

        fields          (U);
        period          1.0;         // cycle period [s]
    }

    // Every control spelled out.
    bbpaFull
    {
        type            BBPA;
        libs            ("libPhaseAveraging.so");
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;

        // WHAT: a plain name gets every product; a { } after a name
        // tunes it. Defaults: writePhaseMean on, secondMoment on,
        // crossCycleVariance on, writePerCycle off.
        fields
        (
            U { writePerCycle on; }              // U_Bin beside U_PA
            p { secondMoment off; }              // skip <p p>
        );

        // The phase grid (also groupable as phaseGrid { ... }).
        period          1.0;
        nBins           50;          // binDeltaT = period/nBins = 0.02
        phaseOrigin     0;           // phase 0 sits at t = 0
        binAlignment    centred;     // window centred on the label | left
        timeQuadrature  endPoint;    // the implemented rule (explicit)

        // The cycle window.
        discardCycles   1;           // skip the from-rest startup cycle
        maxCycles       -1;          // unlimited

        // WHICH bins exist in memory (locked by the restart signature) ...
        accumulationSelection { mode all; }      // | list + bins ( ... )
                                                 // | solverWriteTimes
        // ... and which accumulated bins reach disk (serialisation only).
        outputSelection { mode allAccumulated; } // | list + bins ( ... )

        // WHERE and WHEN (never changes the numbers).
        output
        {
            layout                  phaseAligned;  // | companion | both
            cycleWriteInterval      1;   // dump once per completed cycle
            meanWriteIntervalCycles 1;   // <= 0 = final write only
            writeFinal              true;
            writeProperties         true;          // restartable
        }

        // A field the solver may not create until later cycles:
        // lazy (default) starts it when it appears; strict aborts at once.
        fieldAvailability lazy;
    }
}

