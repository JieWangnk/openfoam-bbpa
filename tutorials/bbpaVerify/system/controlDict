FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;
solver          incompressibleFluid;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         2;

deltaT          0.001;
adjustTimeStep  no;              // fixed dt -> exact, reproducible binning

// phaseSelection solverWriteTimes reads THESE (the solver's) write times,
// so writeControl must be runTime/adjustableRunTime and writeInterval an
// integer multiple of period/nBins (= 0.1). 0.1 == 100*dt, so the writes
// land exactly, and every bin label coincides with a solver write dir.
writeControl    runTime;
writeInterval   0.1;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #includeFunc wallShearStress

    // The v2 BBPA dictionary, annotated. This tutorial is the reference
    // for every control; see README.md for the full explanation.
    bbpaV
    {
        type            BBPA;
        libs            ("libPhaseAveraging.so");

        // -- scheduling (standard function-object controls) --------------
        executeControl  timeStep;    // accumulate EVERY step: BBPA is a
        executeInterval 1;           // time integrator, not a sampler
        writeControl    writeTime;   // write whenever the solver writes

        // -- WHAT: fields and their per-field products --------------------
        // A plain name gets every product; a { } after a name tunes it:
        //   writePhaseMean     (default on)  write the _PA mean file
        //   secondMoment       (default on)  accumulate + write <phi phi>
        //   crossCycleVariance (default on)  accumulate + write Welford
        //   writePerCycle      (default off) keep + write this cycle's _Bin
        fields          ( U );

        // -- the phase grid ----------------------------------------------
        period          1.0;         // cycle period [s]
        nBins           10;          // binDeltaT = period/nBins = 0.1
        phaseOrigin     0;           // phase 0 sits at t = 0
        discardCycles   0;           // no startup cycles discarded here
        maxCycles       -1;          // unlimited

        // -- which bins, and where their windows sit ----------------------
        // solverWriteTimes derives the tracked bins from the solver's
        // write schedule above, so every output lands beside the solver's
        // own fields. (mode all = every bin; mode list + bins (…) = a
        // sparse subset.)
        phaseSelection  { mode solverWriteTimes; }

        // centred: each bin's window is centred on its label time,
        // removing the half-bin phase lag of a left-edge window.
        binAlignment    centred;

        // -- WHERE and WHEN (never changes the numbers) -------------------
        output
        {
            layout              phaseAligned;  // | companion | both
            cycleWriteInterval  1;             // dump once per cycle
            writeFinal          true;
            writeProperties     true;          // restartable
        }
    }
}

