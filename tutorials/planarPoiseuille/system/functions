#includeFunc probes(name=probes, points=((0 1 0)), U)

// ************************************************************************* //

// One job (see README.md): the cross-cycle VARIANCE and restart
// correctness. The Waters-King startup DEVELOPS, so successive "cycles"
// genuinely differ -> the cross-cycle variance is NON-ZERO and checkable.
// On a perfectly periodic flow the variance is ~0 and a variance bug is
// invisible -- which is exactly how the pre-fix pseudo-Welford survived.
// 0.9997 is deliberately NOT a multiple of deltaT (5e-3), so no state can
// land exactly on a cycle boundary or bin edge and the FO's internal time
// can never disagree with the written dir name about which bin a state is
// in.
bbpaV
{
    type            BBPA;
    libs            ("libPhaseAveraging.so");
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;

    fields          ( U );       // all products: mean, <U U>, variance

    period          0.9997;
    nBins           100;
    discardCycles   0;

    output
    {
        layout              phaseAligned;
        cycleWriteInterval  1;   // a restart checkpoint at every cycle
        writeFinal          true;
        writeProperties     true;
    }
}

